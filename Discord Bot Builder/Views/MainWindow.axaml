<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="Discord_Bot_Builder.MainWindow"
        Background="#121212"
        Title="Bot Builder"
        Foreground="White"
        >
        <StackPanel Classes="AccentColor" Orientation="Horizontal" Width="1280" Height="720">
                <StackPanel Width="430" Height="720">
                        <TextBlock Text="Test"/>
                </StackPanel>
                <StackPanel Width="425" Height="720"></StackPanel>
                <StackPanel Width="425" Height="720"></StackPanel>
        </StackPanel>
</Window>
